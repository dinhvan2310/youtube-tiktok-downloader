{
  "name": "tool-download-video",
  "version": "1.0.3",
  "description": "Electron desktop client for Tool Download Video",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev:renderer": "vite --config vite.config.mjs",
    "build:renderer": "vite build --config vite.config.mjs",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-backend.ps1",
    "dist": "npm run build:renderer && npm run build:backend && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --dir",
    "dist:installer": "npm run build:renderer && npm run build:backend && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.tool.downloadvideo",
    "productName": "Tool Download Video",
    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "!backend-dist/**",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "backend-dist/ToolDownloadVideoBackend",
        "to": "backend/ToolDownloadVideoBackend"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tool Download Video",
      "artifactName": "Tool-Download-Video-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  }
}
